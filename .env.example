# --- MongoDB -------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017        Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mapspace

# --- Server --------------------------------------------------------------
PORT=4000
# Comma separated browser origins allowed to call the API (not needed when you use the Vite /api proxy).
CORS_ORIGIN=http://localhost:5173
# REQUIRED in production: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Session length in hours
SESSION_HOURS=8

# --- First Super Admin (created only when the admins collection is empty) ---
SEED_ADMIN_ID=MS-ADM-001
SEED_ADMIN_NAME=Sagnik Mondal
SEED_ADMIN_KEY=MS-SUPER-2026

# --- Optional Google sign-in ----------------------------------------------
GOOGLE_CLIENT_ID=
# Comma separated Google accounts allowed in. Leave empty to block Google sign-in entirely.
ADMIN_EMAILS=

# --- Deployment extras -----------------------------------------------------
# Set to 1 when running behind nginx / a load balancer so login throttling sees real client IPs.
# TRUST_PROXY=1
# Set to false to skip loading demo records on the very first start (you still get the first Super Admin).
# SEED_DEMO=false
