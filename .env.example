# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173 and your production URL
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# With the server, the allow-list is ADMIN_EMAILS in server/.env (enforced server-side).
# This one only matters in local demo mode:
VITE_ADMIN_EMAILS=you@gmail.com
# MongoDB server. /api works in dev (Vite proxy) and when the server also serves the built app.
# Remove this line to run in local demo mode (browser storage only, no database).
VITE_API_URL=/api
# VITE_ALLOW_DEMO=1   # show demo sign-in in a production build
